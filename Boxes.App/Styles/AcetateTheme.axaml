<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style>
    <Style.Resources>
      <!-- Acetate Theme - Vibrant, translucent colored sheets -->
      
      <!-- Core colors - Vibrant acetate palette -->
      <SolidColorBrush x:Key="AccentBrush" Color="#FF00D4AA"/>
      <SolidColorBrush x:Key="AccentMutedBrush" Color="#8000D4AA"/>
      <SolidColorBrush x:Key="SurfaceBrush" Color="#FF0A0E14"/>
      <SolidColorBrush x:Key="SurfaceElevatedBrush" Color="#FF151A20"/>
      <SolidColorBrush x:Key="BorderBrush" Color="#FF2A3540"/>

      <!-- Acetate-specific surfaces - Vibrant translucent layers -->
      <SolidColorBrush x:Key="AcetateSurfaceBrush" Color="#FF1A2030"/>
      <SolidColorBrush x:Key="AcetateHighlightBrush" Color="#FF2A3550"/>
      <SolidColorBrush x:Key="AcetateOverlayBrush" Color="#2000D4AA"/>
      
      <!-- Acetate color sheets -->
      <SolidColorBrush x:Key="AcetateCyanBrush" Color="#2000D4FF"/>
      <SolidColorBrush x:Key="AcetateGreenBrush" Color="#2000D4AA"/>
      <SolidColorBrush x:Key="AcetatePurpleBrush" Color="#208855FF"/>
      <SolidColorBrush x:Key="AcetateOrangeBrush" Color="#20FF8800"/>
      <SolidColorBrush x:Key="AcetatePinkBrush" Color="#20FF0088"/>
      
      <!-- Text colors -->
      <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFFFFFFF"/>
      <SolidColorBrush x:Key="TextSecondaryBrush" Color="#CCFFFFFF"/>
      <SolidColorBrush x:Key="TextTertiaryBrush" Color="#99FFFFFF"/>
      
      <!-- Interactive states -->
      <SolidColorBrush x:Key="InteractiveHoverBrush" Color="#30FFFFFF"/>
      <SolidColorBrush x:Key="InteractivePressedBrush" Color="#2000D4AA"/>
      <SolidColorBrush x:Key="InteractiveFocusBrush" Color="#4000D4AA"/>
      
      <!-- Glow effects -->
      <SolidColorBrush x:Key="GlowAccentBrush" Color="#4000D4AA"/>
      <SolidColorBrush x:Key="GlowHighlightBrush" Color="#30FFFFFF"/>
      
      <!-- Spacing scale -->
      <x:Int32 x:Key="Space4">4</x:Int32>
      <x:Int32 x:Key="Space8">8</x:Int32>
      <x:Int32 x:Key="Space12">12</x:Int32>
      <x:Int32 x:Key="Space16">16</x:Int32>
      <x:Int32 x:Key="Space20">20</x:Int32>
      <x:Int32 x:Key="Space24">24</x:Int32>

      <!-- Corner radii - Sharp for acetate feel -->
      <CornerRadius x:Key="RadiusXS">2</CornerRadius>
      <CornerRadius x:Key="RadiusS">4</CornerRadius>
      <CornerRadius x:Key="RadiusM">6</CornerRadius>
      <CornerRadius x:Key="RadiusL">12</CornerRadius>
      <CornerRadius x:Key="RadiusXL">16</CornerRadius>

      <!-- Borders -->
      <Thickness x:Key="BorderThin">1</Thickness>
      <Thickness x:Key="BorderThick">2</Thickness>
      <Thickness x:Key="BorderGlow">1</Thickness>

      <!-- Shadows - Crisp, defined shadows -->
      <BoxShadows x:Key="ShadowBase">0 1 4 0 #80000000</BoxShadows>
      <BoxShadows x:Key="ShadowRaised">0 2 8 0 #90000000</BoxShadows>
      <BoxShadows x:Key="ShadowFloating">0 4 16 0 #A0000000</BoxShadows>
      <BoxShadows x:Key="ShadowGlow">0 0 12 0 #4000D4AA</BoxShadows>
      
      <!-- Acetate shadow combinations -->
      <BoxShadows x:Key="ShadowAcetate">0 1 3 0 #60000000, 0 0 0 1 #20000000</BoxShadows>
      <BoxShadows x:Key="ShadowAcetateElevated">0 3 8 0 #80000000, 0 0 0 1 #30000000</BoxShadows>
    </Style.Resources>
  </Style>
</Styles>
