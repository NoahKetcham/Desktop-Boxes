<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Pill-shaped metadata badge -->
  <Style Selector="Border.badge">
    <Setter Property="Background" Value="#161A20"/>
    <Setter Property="CornerRadius" Value="12"/>
    <Setter Property="Padding" Value="10,4"/>
    <Setter Property="BorderBrush" Value="#303540"/>
    <Setter Property="BorderThickness" Value="{StaticResource BorderThin}"/>
  </Style>

  <Style Selector="TextBlock.badge-text">
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Opacity" Value="0.85"/>
  </Style>
</Styles>


