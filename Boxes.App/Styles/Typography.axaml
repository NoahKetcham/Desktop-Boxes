<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Page title -->
  <Style Selector="TextBlock.title">
    <Setter Property="FontSize" Value="24"/>
    <Setter Property="FontWeight" Value="Bold"/>
    <Setter Property="LetterSpacing" Value="0"/>
  </Style>

  <!-- Section subtitle -->
  <Style Selector="TextBlock.subtitle">
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="Opacity" Value="0.75"/>
  </Style>

  <!-- Setting description text -->
  <Style Selector="TextBlock.setting-description">
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Opacity" Value="0.6"/>
  </Style>

  <!-- Numbers/counters with monospaced/tabular figures -->
  <Style Selector="TextBlock.numeric">
    <Setter Property="FontFamily" Value="Consolas, Menlo, Monaco, 'Courier New', monospace"/>
  </Style>
</Styles>


