<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Narrow dark scrollbar styling -->
  <Style Selector="ScrollBar">
    <Setter Property="MinWidth" Value="10"/>
    <Setter Property="MinHeight" Value="10"/>
  </Style>

  <Style Selector="ScrollBar /template/ Thumb#PART_Thumb">
    <Setter Property="CornerRadius" Value="8"/>
    <Setter Property="Background" Value="#303540"/>
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.12"/>
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="ScrollBar:pointerover /template/ Thumb#PART_Thumb">
    <Setter Property="Background" Value="#3C4350"/>
  </Style>
  <Style Selector="ScrollBar:pressed /template/ Thumb#PART_Thumb">
    <Setter Property="Background" Value="#4A5363"/>
  </Style>
</Styles>


