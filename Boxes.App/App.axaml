<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Boxes.App.App"
             xmlns:local="using:Boxes.App"
             xmlns:conv="using:Boxes.App.Converters"
             RequestedThemeVariant="Dark">
             <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

   <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>
  
   <Application.Styles>
       <FluentTheme />
       <StyleInclude Source="avares://Avalonia.Controls.ColorPicker/Themes/Fluent/Fluent.xaml"/>
       <StyleInclude Source="avares://Boxes.App/Styles/Tokens.axaml"/>
       <StyleInclude Source="avares://Boxes.App/Styles/Typography.axaml"/>
       <StyleInclude Source="avares://Boxes.App/Styles/Buttons.axaml"/>
       <StyleInclude Source="avares://Boxes.App/Styles/Cards.axaml"/>
       <StyleInclude Source="avares://Boxes.App/Styles/Badges.axaml"/>
       <StyleInclude Source="avares://Boxes.App/Styles/ScrollBar.axaml"/>
       <StyleInclude Source="avares://Boxes.App/Styles/AnimatedCollapsePresenter.axaml"/>
   </Application.Styles>

  <Application.Resources>
      <ResourceDictionary>
          <conv:IntIsZeroToBoolConverter x:Key="IntIsZeroToBoolConverter" />
          <conv:StringEqualsToBoolConverter x:Key="StringEqualsToBoolConverter" />
      </ResourceDictionary>
  </Application.Resources>
</Application>