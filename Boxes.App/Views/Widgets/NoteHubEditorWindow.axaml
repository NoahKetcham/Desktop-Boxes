<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Boxes.App.ViewModels.Widgets"
        xmlns:edit="clr-namespace:AvaloniaEdit;assembly=AvaloniaEdit"
        x:Class="Boxes.App.Views.Widgets.NoteHubEditorWindow"
        x:DataType="vm:NoteHubWindowViewModel"
        Width="400"
        Height="300"
        MinWidth="280"
        MinHeight="200"
        CanResize="True"
        CanMinimize="False"
        CanMaximize="False"
        ShowActivated="True"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        SystemDecorations="BorderOnly"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaTitleBarHeightHint="-1"
        TransparencyLevelHint="Transparent"
        Background="Transparent">

    <Window.Styles>
        <Style Selector="Button.header-btn">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="Opacity" Value="0.7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.1"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.header-btn:pointerover">
            <Setter Property="Opacity" Value="1"/>
            <Setter Property="Background" Value="#20FFFFFF"/>
        </Style>
        <Style Selector="Button.breadcrumb-segment">
            <Setter Property="Background" Value="#2A3142"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="Button.breadcrumb-segment:pointerover">
            <Setter Property="Background" Value="#3A4152"/>
        </Style>
    </Window.Styles>

    <Grid x:Name="RootGrid" Background="#1C2235" ClipToBounds="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header Bar (with breadcrumb navigation) -->
        <Border x:Name="HeaderBar" Grid.Row="0" Background="#232B46" Padding="10,8" MinHeight="40"
                CornerRadius="8,8,0,0"
                BorderThickness="0,0,0,1" BorderBrush="#2A3142"
                PointerPressed="Header_PointerPressed" PointerMoved="Header_PointerMoved" PointerReleased="Header_PointerReleased">
            <Grid ColumnDefinitions="*,Auto,Auto" VerticalAlignment="Center">
                <ItemsControl Grid.Column="0" ItemsSource="{Binding BreadcrumbSegments}" VerticalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="4"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:BreadcrumbSegmentViewModel">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <Button Classes="breadcrumb-segment" 
                                        Content="{Binding DisplayName}"
                                        Command="{Binding NavigateCommand}"
                                        IsEnabled="{Binding !IsLast}"/>
                                <TextBlock Text="›" IsVisible="{Binding !IsLast}"
                                           Foreground="#808080" FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Grid.Column="1" Classes="header-btn" Padding="6,4" ToolTip.Tip="Markdown formatting">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock Text="▼" FontSize="10" VerticalAlignment="Center" Opacity="0.8"/>
                        <TextBlock Text="Markdown" FontSize="12" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button.Flyout>
                        <MenuFlyout Placement="Bottom">
                        <MenuItem Header="Bold" Click="MarkdownBold_OnClick"/>
                        <MenuItem Header="Italic" Click="MarkdownItalic_OnClick"/>
                        <MenuItem Header="Strikethrough" Click="MarkdownStrikethrough_OnClick"/>
                        <MenuItem Header="-"/>
                        <MenuItem Header="Link" Click="MarkdownLink_OnClick"/>
                        <MenuItem Header="Code" Click="MarkdownCode_OnClick"/>
                        <MenuItem Header="Code block" Click="MarkdownCodeBlock_OnClick"/>
                        <MenuItem Header="-"/>
                        <MenuItem Header="Heading 1" Click="MarkdownHeading1_OnClick"/>
                        <MenuItem Header="Heading 2" Click="MarkdownHeading2_OnClick"/>
                        <MenuItem Header="Heading 3" Click="MarkdownHeading3_OnClick"/>
                        <MenuItem Header="-"/>
                        <MenuItem Header="Bullet list" Click="MarkdownBullet_OnClick"/>
                        <MenuItem Header="Numbered list" Click="MarkdownNumbered_OnClick"/>
                        <MenuItem Header="Blockquote" Click="MarkdownBlockquote_OnClick"/>
                        <MenuItem Header="-"/>
                        <MenuItem Header="Horizontal rule" Click="MarkdownHr_OnClick"/>
                        <MenuItem Header="-"/>
                        <MenuItem Header="Highlight" Click="MarkdownHighlight_OnClick"/>
                        <MenuItem Header="Color (red)" Click="MarkdownColorRed_OnClick"/>
                        <MenuItem Header="Color (green)" Click="MarkdownColorGreen_OnClick"/>
                        <MenuItem Header="Color (blue)" Click="MarkdownColorBlue_OnClick"/>
                        <MenuItem Header="Color (orange)" Click="MarkdownColorOrange_OnClick"/>
                        <MenuItem Header="Color (yellow)" Click="MarkdownColorYellow_OnClick"/>
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
                <Button Grid.Column="2" Classes="header-btn" Width="26" Height="26"
                    Command="{Binding CloseEditorCommand}"
                    ToolTip.Tip="Close"
                    PointerPressed="Button_OnPointerPressed">
                    <TextBlock Text="✕" FontSize="12" HorizontalAlignment="Center"/>
                </Button>
            </Grid>
        </Border>

        <!-- Content Area: Editor or folder view -->
        <Border x:Name="ContentArea" Grid.Row="1" Padding="12" CornerRadius="0,0,8,8">
            <Grid>
                <!-- File mode: Editor (AvaloniaEdit with markdown syntax highlighting) -->
                <edit:TextEditor x:Name="EditorTextBox"
                                IsVisible="{Binding IsFileMode}"
                                ShowLineNumbers="False"
                                FontFamily="Consolas, Courier New, monospace"
                                FontSize="13"
                                Background="Transparent"
                                Foreground="#E0E0E0"
                                Padding="8"
                                HorizontalScrollBarVisibility="Auto"
                                VerticalScrollBarVisibility="Auto"
                                MinHeight="200"/>
                <!-- Folder mode: Directory entries -->
                <ScrollViewer IsVisible="{Binding !IsFileMode}">
                    <StackPanel Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="+ New note" Classes="btn-subtle" Command="{Binding CreateNewNoteCommand}"/>
                            <Button Content="+ New folder" Classes="btn-subtle" Command="{Binding CreateFolderCommand}"/>
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding CurrentEntries}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:NoteHubEntryViewModel">
                                    <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                                        <Button Grid.Column="0" Classes="header-btn" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                                Command="{Binding NavigateCommand}" Padding="8,6">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="{Binding DisplayIcon}" FontSize="14"/>
                                                <TextBlock Text="{Binding Name}" FontSize="13" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Grid.Column="1" Classes="header-btn" Command="{Binding RenameCommand}"
                                                Padding="6,4" ToolTip.Tip="Rename" VerticalAlignment="Center"
                                                PointerPressed="Button_OnPointerPressed">
                                            <TextBlock Text="✎" FontSize="11" Opacity="0.7"/>
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Resize Handles -->
        <Border Tag="Right" HorizontalAlignment="Right" VerticalAlignment="Stretch" Width="6" Background="Transparent"
                Cursor="SizeWestEast" PointerPressed="ResizeHandle_OnPointerPressed"/>
        <Border Tag="Bottom" HorizontalAlignment="Stretch" VerticalAlignment="Bottom" Height="6" Background="Transparent"
                Cursor="SizeNorthSouth" PointerPressed="ResizeHandle_OnPointerPressed"/>
        <Border Tag="BottomRight" HorizontalAlignment="Right" VerticalAlignment="Bottom" Width="12" Height="12" Background="Transparent"
                Cursor="SizeAll" PointerPressed="ResizeHandle_OnPointerPressed"/>
    </Grid>
</Window>
