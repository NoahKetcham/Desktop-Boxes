<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:widgetsVm="using:Boxes.App.ViewModels.Widgets"
        x:Class="Boxes.App.Views.Widgets.CommandCenterWindow"
        x:DataType="widgetsVm:CommandCenterWindowViewModel"
        Width="360"
        Height="108"
        MinWidth="63"
        MinHeight="60"
        CanResize="False"
        CanMinimize="False"
        CanMaximize="False"
        ShowActivated="True"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        SystemDecorations="BorderOnly"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaTitleBarHeightHint="0"
        TransparencyLevelHint="Transparent"
        Background="Transparent">
    <Window.Resources>
        <SolidColorBrush x:Key="CommandCenterActionPrimary" Color="#FFFFFFFF"/>
        <SolidColorBrush x:Key="CommandCenterActionPrimaryHover" Color="#FFFFFFFF"/>
        <SolidColorBrush x:Key="CommandCenterActionSecondary" Color="#14000000"/>
        <SolidColorBrush x:Key="CommandCenterActionSecondaryHover" Color="#22FFFFFF"/>
        <SolidColorBrush x:Key="CommandCenterActionIconBg" Color="#20FFFFFF"/>
        <Thickness x:Key="CommandCenterActionPadding">6</Thickness>
        <x:Double x:Key="CommandCenterIconSize">28</x:Double>
        <CornerRadius x:Key="CommandCenterIconCornerRadius">9</CornerRadius>
        <x:Double x:Key="CommandCenterIconFontSize">13</x:Double>
    </Window.Resources>

    <Window.Styles>
        <Style Selector="Border.command-center-shell">
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <Style Selector="Button.command-center-action">
            <Setter Property="Background" Value="{DynamicResource CommandCenterActionSecondary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="{DynamicResource CommandCenterActionPadding}"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="{DynamicResource CommandCenterActionMargin}"/>
        </Style>

        <Style Selector="Button.command-center-action /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="ClipToBounds" Value="False"/>
        </Style>

        <Style Selector="Button.command-center-action:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource CommandCenterActionSecondary}"/>
        </Style>

        <Style Selector="Button.command-center-action:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource CommandCenterActionSecondary}"/>
        </Style>

        <Style Selector="Button.command-center-action Border.command-center-icon-bg">
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform" Value="scale(1)"/>
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.1"/>
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="Button.command-center-action:pointerover Border.command-center-icon-bg">
            <Setter Property="RenderTransform" Value="scale(1.1)"/>
        </Style>

        <Style Selector="Button.command-center-action:pointerover TextBlock.command-center-icon">
            <Setter Property="Foreground" Value="{DynamicResource CommandCenterActionPrimaryHover}"/>
        </Style>
    </Window.Styles>

    <Grid x:Name="RootGrid" PointerPressed="Chrome_PointerPressed" ClipToBounds="False">
        <Border x:Name="OuterBorder" Classes="command-center-shell" Padding="6,4,6,4"
                ClipToBounds="False">
            <ItemsControl x:Name="ActionsItemsControl" ItemsSource="{Binding Actions}"
                          HorizontalAlignment="Center">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel x:Name="ActionWrapPanel" Orientation="Horizontal" ItemWidth="52" ItemHeight="52" ItemsAlignment="Center"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="widgetsVm:CommandCenterActionButtonViewModel">
                        <Button Classes="command-center-action"
                                Command="{Binding Command}"
                                ToolTip.Tip="{Binding Title}"
                                PointerPressed="Button_OnPointerPressed">
                            <StackPanel Spacing="0"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                <Border Classes="command-center-icon-bg"
                                        Width="{DynamicResource CommandCenterIconSize}"
                                        Height="{DynamicResource CommandCenterIconSize}"
                                        CornerRadius="{DynamicResource CommandCenterIconCornerRadius}"
                                        Background="{DynamicResource CommandCenterActionIconBg}"
                                        HorizontalAlignment="Center">
                                    <TextBlock Classes="command-center-icon"
                                               Text="{Binding Icon}"
                                               Foreground="{DynamicResource CommandCenterActionPrimary}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontSize="{DynamicResource CommandCenterIconFontSize}"
                                               FontWeight="Bold"/>
                                </Border>
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <Border Tag="Right"
                HorizontalAlignment="Right"
                VerticalAlignment="Stretch"
                Width="6"
                Background="Transparent"
                Cursor="SizeWestEast"
                IsHitTestVisible="{Binding !IsLocked}"
                PointerPressed="ResizeHandle_OnPointerPressed"/>
        <Border Tag="Bottom"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Bottom"
                Height="6"
                Background="Transparent"
                Cursor="SizeNorthSouth"
                IsHitTestVisible="{Binding !IsLocked}"
                PointerPressed="ResizeHandle_OnPointerPressed"/>
        <Border Tag="BottomRight"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Width="12"
                Height="12"
                Background="Transparent"
                Cursor="SizeAll"
                IsHitTestVisible="{Binding !IsLocked}"
                PointerPressed="ResizeHandle_OnPointerPressed"/>
    </Grid>
</Window>
