<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Boxes.App.ViewModels"
        x:Class="Boxes.App.Views.Dialogs.ShortcutSelectionDialog"
        x:DataType="vm:ShortcutSelectionViewModel"
        Width="520"
        Height="420"
        CanResize="True"
        MinWidth="400"
        MinHeight="300"
        WindowStartupLocation="CenterOwner"
        Title="Box Settings">
    <Border Padding="24" Background="{StaticResource SurfaceBrush}">
        <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="16">
            <StackPanel Spacing="4">
                <TextBlock Text="Box Settings" FontSize="18" FontWeight="SemiBold"/>
                <TextBlock Classes="subtitle">
                    <Run Text="Configuring: "/>
                    <Run Text="{Binding BoxName}" FontWeight="Medium"/>
                </TextBlock>
            </StackPanel>
            
            <Border Grid.Row="1" Background="{StaticResource SurfaceElevatedBrush}" 
                    CornerRadius="{StaticResource RadiusS}" Padding="12">
                <StackPanel Spacing="12">
                    <CheckBox Content="Snap to taskbar" IsChecked="{Binding IsSnappedToTaskbar}"
                              ToolTip.Tip="Pin this box to the taskbar edge"/>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="🏠 Home" Classes="btn-subtle" Command="{Binding NavigateHomeCommand}"
                                ToolTip.Tip="Go to root folder"/>
                        <Button Content="↑ Up" Classes="btn-subtle" Command="{Binding NavigateUpCommand}"
                                ToolTip.Tip="Go to parent folder"/>
                        <Border Background="{StaticResource SurfaceBrush}" CornerRadius="4" Padding="8,4" VerticalAlignment="Center">
                            <TextBlock Text="{Binding CurrentPath}" FontSize="12" Opacity="0.9"/>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Border>
            
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding CurrentItems}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel ItemWidth="110" ItemHeight="110" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ShortcutSelectionItemViewModel">
                            <ToggleButton IsChecked="{Binding IsSelected}" Width="100" Height="100" Margin="4" 
                                          Background="{StaticResource SurfaceElevatedBrush}" 
                                          BorderBrush="{StaticResource BorderBrush}" 
                                          BorderThickness="1" CornerRadius="{StaticResource RadiusS}" 
                                          DoubleTapped="ShortcutItem_OnDoubleTapped"
                                          ToolTip.Tip="{Binding FileName}">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6">
                                    <Border Width="40" Height="40" Background="{StaticResource SurfaceBrush}" CornerRadius="4">
                                        <Image Source="{Binding Icon}" Width="40" Height="40" Stretch="Uniform"/>
                                    </Border>
                                    <TextBlock Text="{Binding FileName}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" 
                                               TextAlignment="Center" MaxWidth="88" FontSize="11" />
                                </StackPanel>
                            </ToggleButton>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            
            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
                <Button Content="Cancel" Classes="btn-subtle" Command="{Binding CancelCommand}"
                        ToolTip.Tip="Discard changes" AutomationProperties.Name="Cancel"/>
                <Button Content="Save Changes" Classes="btn-primary" Command="{Binding SaveCommand}"
                        ToolTip.Tip="Save box settings" AutomationProperties.Name="Save changes"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
