<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Boxes.App.ViewModels"
        x:Class="Boxes.App.Views.Dialogs.ConfirmationDialog"
        x:DataType="vm:ConfirmationDialogViewModel"
        Width="400"
        Height="200"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Title="Confirm Action">
    <Border Padding="28" Background="{StaticResource SurfaceBrush}">
        <Grid RowDefinitions="Auto,*,Auto" RowSpacing="20">
            <TextBlock Text="Please Confirm" FontSize="18" FontWeight="SemiBold"/>
            
            <Border Grid.Row="1" Background="{StaticResource SurfaceElevatedBrush}" 
                    CornerRadius="{StaticResource RadiusM}" Padding="16">
                <TextBlock Text="{Binding Message}" TextWrapping="Wrap" FontSize="14" LineHeight="22"/>
            </Border>
            
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
                <Button Content="Cancel" Classes="btn-subtle" Command="{Binding CancelCommand}"
                        ToolTip.Tip="Cancel this action" AutomationProperties.Name="Cancel"/>
                <Button Content="Confirm" Classes="btn-primary" Command="{Binding ConfirmCommand}"
                        ToolTip.Tip="Proceed with this action" AutomationProperties.Name="Confirm"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
