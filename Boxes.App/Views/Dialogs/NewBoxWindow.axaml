<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:vm="using:Boxes.App.ViewModels"
        x:Class="Boxes.App.Views.Dialogs.NewBoxWindow"
        x:DataType="vm:NewBoxDialogViewModel"
        Width="440"
        Height="380"
        Title="Create Box"
        CanResize="False"
        WindowStartupLocation="CenterOwner">

    <Window.DataContext>
        <vm:NewBoxDialogViewModel/>
    </Window.DataContext>

    <Border Padding="28" Background="{StaticResource SurfaceBrush}">
        <Grid RowDefinitions="Auto,*,Auto" RowSpacing="20">
            <StackPanel Spacing="6">
                <TextBlock Text="Create a new box" Classes="title" FontSize="20"/>
                <TextBlock Text="Group files and folders into a curated space on your desktop." Classes="subtitle" TextWrapping="Wrap"/>
            </StackPanel>

            <StackPanel Grid.Row="1" Spacing="16">
                <StackPanel Spacing="6">
                    <TextBlock Text="Name" FontSize="13" FontWeight="Medium" Opacity="0.9"/>
                    <TextBox Watermark="Enter box name" Text="{Binding Name, Mode=TwoWay}"
                             ToolTip.Tip="Give your box a memorable name"
                             AutomationProperties.Name="Box name"/>
                </StackPanel>
                <StackPanel Spacing="6">
                    <TextBlock Text="Description (optional)" FontSize="13" FontWeight="Medium" Opacity="0.9"/>
                    <TextBox Watermark="What will this box contain?" Text="{Binding Description, Mode=TwoWay}" 
                             AcceptsReturn="True" Height="70" TextWrapping="Wrap"
                             ToolTip.Tip="Describe the purpose of this box"
                             AutomationProperties.Name="Box description"/>
                </StackPanel>
                <StackPanel Spacing="6">
                    <TextBlock Text="Target folder (optional)" FontSize="13" FontWeight="Medium" Opacity="0.9"/>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <TextBox Watermark="Link to a folder on your computer" Text="{Binding TargetPath, Mode=TwoWay}"
                                 ToolTip.Tip="Automatically include files from this folder"
                                 AutomationProperties.Name="Target folder path"/>
                        <Button Grid.Column="1" Content="Browse" Classes="btn-subtle" Command="{Binding BrowseCommand}"
                                ToolTip.Tip="Browse for folder" AutomationProperties.Name="Browse for folder"/>
                    </Grid>
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
                <Button Content="Cancel" Classes="btn-subtle" Command="{Binding CancelCommand}"
                        ToolTip.Tip="Cancel and close" AutomationProperties.Name="Cancel"/>
                <Button Content="Create Box" Classes="btn-primary" Command="{Binding CreateCommand}" IsEnabled="{Binding CanCreate}"
                        ToolTip.Tip="Create the new box" AutomationProperties.Name="Create box"/>
            </StackPanel>
        </Grid>
    </Border>

</Window>

