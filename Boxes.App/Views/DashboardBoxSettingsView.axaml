<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Boxes.App.ViewModels"
             x:Class="Boxes.App.Views.DashboardBoxSettingsView"
             x:DataType="vm:DashboardBoxSettingsViewModel">

    <Design.DataContext>
        <vm:DashboardBoxSettingsViewModel/>
    </Design.DataContext>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid>
            <!-- Empty State -->
            <StackPanel Spacing="20" IsVisible="{Binding !HasCurrentBox}">
                <StackPanel Spacing="6">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="⚙️" FontSize="18"/>
                        <TextBlock Text="Box Settings" FontWeight="Bold" FontSize="18"/>
                    </StackPanel>
                    <TextBlock Text="Select a box from the list and click Settings to configure it." 
                               TextWrapping="Wrap" Classes="subtitle" LineHeight="20"/>
                </StackPanel>
                
                <!-- Empty State Illustration -->
                <Border Background="{StaticResource SurfaceElevatedBrush}" 
                        CornerRadius="{StaticResource RadiusM}" 
                        Padding="24" HorizontalAlignment="Center">
                    <StackPanel Spacing="12" HorizontalAlignment="Center">
                        <TextBlock Text="📦" FontSize="40" HorizontalAlignment="Center" Opacity="0.4"/>
                        <TextBlock Text="No box selected" FontSize="14" FontWeight="Medium" Opacity="0.6" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
                
                <Border Background="{StaticResource SurfaceBrush}" 
                        CornerRadius="{StaticResource RadiusS}" 
                        Padding="16">
                    <StackPanel Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="💡" FontSize="14"/>
                            <TextBlock Text="Quick Tip" FontWeight="Medium" FontSize="13"/>
                        </StackPanel>
                        <TextBlock Text="Click the Settings button on any box card in the list to configure its name, description, and view item details." 
                                   TextWrapping="Wrap" FontSize="12" Opacity="0.7" LineHeight="18"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Populated State -->
            <Grid RowDefinitions="Auto,*" IsVisible="{Binding HasCurrentBox}">
                <!-- Header -->
                <StackPanel Grid.Row="0" Spacing="6" Margin="0,0,0,20">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="⚙️" FontSize="18"/>
                        <TextBlock Text="Box Settings" FontWeight="Bold" FontSize="18"/>
                    </StackPanel>
                    <TextBlock Text="Configure your box below. Changes are saved automatically." 
                               TextWrapping="Wrap" Classes="subtitle"/>
                </StackPanel>

                <!-- Content -->
                <StackPanel Grid.Row="1" Spacing="16">
                    <!-- Name Field -->
                    <StackPanel Spacing="6">
                        <TextBlock Text="Name" FontWeight="Medium" FontSize="13" Opacity="0.9"/>
                        <TextBox Text="{Binding BoxName, Mode=TwoWay}" 
                                 Watermark="Enter box name..."
                                 ToolTip.Tip="The display name for this box"
                                 AutomationProperties.Name="Box name"/>
                    </StackPanel>

                    <!-- Description Field -->
                    <StackPanel Spacing="6">
                        <TextBlock Text="Description" FontWeight="Medium" FontSize="13" Opacity="0.9"/>
                        <TextBox Text="{Binding BoxDescription, Mode=TwoWay}" 
                                 Watermark="What is this box for?"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 MinHeight="70"
                                 MaxHeight="100"
                                 ToolTip.Tip="Optional description for this box"
                                 AutomationProperties.Name="Box description"/>
                    </StackPanel>

                    <!-- Details Card -->
                    <Border Background="{StaticResource SurfaceElevatedBrush}" 
                            CornerRadius="{StaticResource RadiusS}" Padding="16">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Details" FontWeight="Medium" FontSize="13"/>
                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="8">
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Shortcuts" FontSize="12" Opacity="0.7"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" 
                                           Text="{Binding CurrentBox.ItemCount}" 
                                           FontWeight="SemiBold" FontSize="13" Classes="numeric"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Actions -->
                    <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right" Margin="0,8,0,0">
                        <Button Content="Done" Classes="btn-subtle" Command="{Binding ClearCommand}"
                                ToolTip.Tip="Close settings panel" AutomationProperties.Name="Close settings"/>
                        <Button Content="Delete Box" Classes="btn-danger" Command="{Binding DeleteCommand}"
                                ToolTip.Tip="Permanently delete this box" AutomationProperties.Name="Delete box"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Grid>
    </ScrollViewer>

</UserControl>
