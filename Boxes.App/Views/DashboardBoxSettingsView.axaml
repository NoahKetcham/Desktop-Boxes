<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Boxes.App.ViewModels"
             x:Class="Boxes.App.Views.DashboardBoxSettingsView"
             x:DataType="vm:DashboardBoxSettingsViewModel">

    <Design.DataContext>
        <vm:DashboardBoxSettingsViewModel/>
    </Design.DataContext>

    <Border Background="#1F2740"
            CornerRadius="16"
            Padding="24">
        <Grid>
            <!-- Empty State -->
            <StackPanel Spacing="16" IsVisible="{Binding !HasCurrentBox}">
                <StackPanel Spacing="4">
                    <TextBlock Text="Box Settings" FontWeight="Bold" FontSize="20"/>
                    <TextBlock Text="Select a box and press Settings to edit its details." 
                               TextWrapping="Wrap" Opacity="0.8"/>
                </StackPanel>
                <Border Background="#12162A" CornerRadius="12" Padding="16">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Quick Tip" FontWeight="SemiBold" FontSize="16"/>
                        <TextBlock Text="Click the gear icon on any box card to configure its name and view item count." 
                                   TextWrapping="Wrap" Opacity="0.7"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Populated State -->
            <Grid RowDefinitions="Auto,*" IsVisible="{Binding HasCurrentBox}">
                <!-- Header -->
                <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,20">
                    <TextBlock Text="Box Settings" FontWeight="Bold" FontSize="20"/>
                    <TextBlock Text="Edit your box configuration below." 
                               TextWrapping="Wrap" Opacity="0.8"/>
                </StackPanel>

                <!-- Content -->
                <StackPanel Grid.Row="1" Spacing="12">
                    <StackPanel Spacing="6">
                        <TextBlock Text="Name" FontWeight="SemiBold" FontSize="14"/>
                        <TextBox Text="{Binding BoxName, Mode=TwoWay}" 
                                 Watermark="Enter box name..."
                                 CornerRadius="8"/>
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Text="Description" FontWeight="SemiBold" FontSize="14"/>
                        <TextBox Text="{Binding BoxDescription, Mode=TwoWay}" 
                                 Watermark="Enter description..."
                                 CornerRadius="8"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 MinHeight="60"
                                 MaxHeight="100"/>
                    </StackPanel>

                    <Border Background="#12162A" CornerRadius="12" Padding="16">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Details" FontWeight="SemiBold" FontSize="14"/>
                            <Grid ColumnDefinitions="Auto,*">
                                <TextBlock Grid.Column="0" Text="Items:" Opacity="0.7"/>
                                <TextBlock Grid.Column="1" 
                                           Text="{Binding CurrentBox.ItemCount}" 
                                           HorizontalAlignment="Right"
                                           FontWeight="SemiBold"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Button Content="Delete"
                            Command="{Binding DeleteCommand}"
                            HorizontalAlignment="Right"
                            Width="90"
                            Margin="0,10,0,0"
                            Background="#4A1F1F"
                            Foreground="#FF6B6B"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>

</UserControl>
