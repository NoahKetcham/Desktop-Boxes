<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Boxes.App.ViewModels"
             x:Class="Boxes.App.Views.SettingsPageView"
             x:DataType="vm:SettingsPageViewModel">

    <Design.DataContext>
        <vm:SettingsPageViewModel/>
    </Design.DataContext>

    <Grid RowDefinitions="Auto,*">
        <StackPanel Spacing="4" Grid.Row="0">
            <TextBlock Text="{Binding Title}" Classes="title"/>
            <TextBlock Text="{Binding Description}" Classes="subtitle"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Border HorizontalAlignment="Center" MaxWidth="1000" Padding="16">
            <StackPanel Spacing="12">
                <Border Classes="card-row" Background="{StaticResource SurfaceElevatedBrush}" CornerRadius="{StaticResource RadiusL}" Padding="16">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Appearance" FontWeight="SemiBold" FontSize="16"/>
                        <ComboBox SelectedItem="{Binding ThemePreference, Mode=TwoWay}">
                            <ComboBoxItem Content="System"/>
                            <ComboBoxItem Content="Light"/>
                            <ComboBoxItem Content="Dark"/>
                        </ComboBox>
                    </StackPanel>
                </Border>

                <!-- Accent color selector -->
                <Border Classes="card-row" Background="{StaticResource SurfaceElevatedBrush}" CornerRadius="{StaticResource RadiusL}" Padding="16">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Accent color" FontWeight="SemiBold" FontSize="16"/>
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                            <Border Grid.Column="0" Width="28" Height="28" CornerRadius="6" BorderBrush="{StaticResource BorderBrush}" BorderThickness="{StaticResource BorderThin}" Background="{StaticResource AccentBrush}"/>
                            <TextBox Grid.Column="1" Text="{Binding AccentHex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Watermark="#3A8DFF"/>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                                <Button Content="Apply" Classes="btn-primary" Command="{Binding ApplyAccentCommand}"/>
                                <Button Content="Reset" Classes="btn-subtle" Command="{Binding ResetAccentCommand}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Classes="card-row" Background="{StaticResource SurfaceElevatedBrush}" CornerRadius="{StaticResource RadiusL}" Padding="16">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Behavior" FontWeight="SemiBold" FontSize="16"/>
                        <ToggleSwitch Content="Auto snap new boxes" IsChecked="{Binding AutoSnapEnabled, Mode=TwoWay}"/>
                        <ToggleSwitch Content="Show box outlines" IsChecked="{Binding ShowBoxOutlines, Mode=TwoWay}"/>
                    </StackPanel>
                </Border>

                <Border Classes="card-row" Background="{StaticResource SurfaceElevatedBrush}" CornerRadius="{StaticResource RadiusL}" Padding="16">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Integrations" FontWeight="SemiBold" FontSize="16"/>
                        <ToggleSwitch Content="OneDrive linked" IsChecked="{Binding OneDriveLinked, Mode=TwoWay}"/>
                        <ToggleSwitch Content="Google Drive linked" IsChecked="{Binding GoogleDriveLinked, Mode=TwoWay}"/>
                        <Button Content="Create 'Show Boxes' Start Menu Shortcut" Command="{Binding CreateShowBoxesShortcutCommand}"/>
                        <StackPanel Orientation="Vertical" Spacing="8">
                            <Button Content="Save" Classes="btn-subtle" Command="{Binding SaveCommand}" HorizontalAlignment="Stretch"/>
                            <Button Content="Delete All Saved Data" Classes="btn-danger" Command="{Binding ResetDataCommand}" HorizontalAlignment="Stretch"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Classes="card-row" Background="{StaticResource SurfaceElevatedBrush}" CornerRadius="{StaticResource RadiusL}" Padding="16">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Developer Settings" FontWeight="SemiBold" FontSize="16"/>
                        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                            <TextBlock Text="Boxes Transparency" VerticalAlignment="Center" Width="160"/>
                            <Slider Minimum="0" Maximum="100" Value="{Binding BoxesTransparencyPercent, Mode=TwoWay}" TickFrequency="10" IsSnapToTickEnabled="False" Width="200"/>
                            <TextBlock Text="{Binding BoxesTransparencyPercent, StringFormat='{}{0}%'}" VerticalAlignment="Center" Width="50"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="Open All Windows" Classes="btn-subtle" Command="{Binding OpenAllWindowsCommand}"/>
                            <Button Content="Close All Windows" Classes="btn-subtle" Command="{Binding CloseAllWindowsCommand}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
            </Border>
        </ScrollViewer>
    </Grid>

</UserControl>

