<UserControl x:Name="DashboardView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Boxes.App.ViewModels"
             xmlns:controls="using:Boxes.App.Views.Controls"
             x:Class="Boxes.App.Views.DashboardPageView"
             x:DataType="vm:DashboardPageViewModel"
             mc:Ignorable="d">

    <Design.DataContext>
        <vm:DashboardPageViewModel/>
    </Design.DataContext>

    <UserControl.Styles>
        <Style Selector="TabControl.dashboard-tabs">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
        <Style Selector="TabControl.dashboard-tabs > TabItem">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Opacity" Value="0.6"/>
        </Style>
        <Style Selector="TabControl.dashboard-tabs > TabItem:pointerover">
            <Setter Property="Background" Value="{StaticResource SurfaceElevatedBrush}"/>
            <Setter Property="Opacity" Value="0.85"/>
        </Style>
        <Style Selector="TabControl.dashboard-tabs > TabItem:selected">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Opacity" Value="1"/>
        </Style>
    </UserControl.Styles>

    <Border HorizontalAlignment="Center" MaxWidth="1000" Padding="24">
        <Grid RowDefinitions="Auto,*">
            <!-- Page Header -->
            <StackPanel Grid.Row="0" Spacing="6" Margin="0,0,0,24">
                <TextBlock Text="Dashboard" Classes="title" FontSize="28"/>
                <TextBlock Text="Manage your desktop boxes, notes, and configurations" Classes="subtitle"/>
            </StackPanel>

            <!-- Tab Control -->
            <TabControl Grid.Row="1" Classes="dashboard-tabs">
                
                <!-- ═══════════════════════════════════════════════════════════════ -->
                <!-- BOXES TAB -->
                <!-- ═══════════════════════════════════════════════════════════════ -->
                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="📦" FontSize="14"/>
                            <TextBlock Text="Boxes"/>
                        </StackPanel>
                    </TabItem.Header>
                    
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,20,0,0">
                        <StackPanel Spacing="20" Margin="0,0,0,40">
                            <!-- Toolbar -->
                            <Border Classes="card-row" Background="{StaticResource SurfaceElevatedBrush}" 
                                    CornerRadius="{StaticResource RadiusM}" Padding="16">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="Your Boxes" FontWeight="SemiBold" FontSize="16"/>
                                        <TextBlock Text="Create and manage desktop organizer boxes" Classes="subtitle" FontSize="12"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                        <Button Content="{Binding DesktopCleanupButtonText}" Classes="btn-subtle" 
                                                Command="{Binding ToggleDesktopCleanupCommand}" 
                                                IsEnabled="{Binding CanToggleDesktopCleanup}"
                                                ToolTip.Tip="Toggle desktop cleanup mode"/>
                                        <Button Classes="btn-primary" Command="{Binding NewBoxCommand}"
                                                ToolTip.Tip="Create a new box">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <TextBlock Text="+"/>
                                                <TextBlock Text="New Box"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Empty State -->
                            <Border x:Name="EmptyState" 
                                    Background="{StaticResource SurfaceElevatedBrush}" 
                                    CornerRadius="{StaticResource RadiusL}" 
                                    Padding="40"
                                    IsVisible="{Binding Boxes.Count, Converter={StaticResource IntIsZeroToBoolConverter}}">
                                <StackPanel Spacing="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Border Width="72" Height="72" CornerRadius="36" HorizontalAlignment="Center">
                                        <Border.Background>
                                            <SolidColorBrush Color="#3A8DFF" Opacity="0.15"/>
                                        </Border.Background>
                                        <TextBlock Text="📦" FontSize="32" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Spacing="6" HorizontalAlignment="Center">
                                        <TextBlock Text="No boxes yet" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Create your first box to start organizing your desktop files and shortcuts." 
                                                   Classes="subtitle" TextAlignment="Center" MaxWidth="320" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <Button Content="Create Your First Box" Classes="btn-primary" 
                                            Command="{Binding NewBoxCommand}" 
                                            HorizontalAlignment="Center"
                                            Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Box List -->
                            <ItemsControl ItemsSource="{Binding Boxes}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Spacing="12"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:BoxSummaryViewModel">
                                        <Border Classes="card-row"
                                                Background="{StaticResource SurfaceElevatedBrush}"
                                                CornerRadius="{StaticResource RadiusL}"
                                                Padding="20">
                                            <Border.Transitions>
                                                <Transitions>
                                                    <BrushTransition Property="Background" Duration="0:0:0.15"/>
                                                </Transitions>
                                            </Border.Transitions>
                                            <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                                                <!-- Box Icon -->
                                                <Border Grid.Column="0" 
                                                        Width="48" Height="48" 
                                                        CornerRadius="12" 
                                                        Margin="0,0,16,0"
                                                        VerticalAlignment="Center">
                                                    <Border.Background>
                                                        <SolidColorBrush Color="#3A8DFF" Opacity="0.12"/>
                                                    </Border.Background>
                                                    <TextBlock Text="📦" FontSize="22" 
                                                               HorizontalAlignment="Center" 
                                                               VerticalAlignment="Center"/>
                                                </Border>

                                                <!-- Box Info -->
                                                <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="15"/>
                                                        <Border Classes="badge" VerticalAlignment="Center">
                                                            <TextBlock Classes="badge-text" Text="{Binding ItemCount, StringFormat='{}{0} items'}"/>
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Description}" 
                                                               Opacity="0.6" 
                                                               FontSize="13"
                                                               IsVisible="{Binding Description, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                                </StackPanel>

                                                <!-- Actions -->
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                    <Button Content="Open" Classes="btn-primary"
                                                            Command="{Binding DataContext.OpenBoxCommand, ElementName=DashboardView}" 
                                                            CommandParameter="{Binding}"
                                                            ToolTip.Tip="Open this box"/>
                                                    <Button Content="Settings" Classes="btn-subtle"
                                                            Command="{Binding DataContext.ConfigureBoxSettingsCommand, ElementName=DashboardView}" 
                                                            CommandParameter="{Binding}"
                                                            ToolTip.Tip="Configure box settings"/>
                                                    <Button Classes="btn-danger"
                                                            Command="{Binding DataContext.DeleteBoxCommand, ElementName=DashboardView}" 
                                                            CommandParameter="{Binding}"
                                                            ToolTip.Tip="Delete this box"
                                                            Padding="10,8">
                                                        <TextBlock Text="🗑" FontSize="14"/>
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- ═══════════════════════════════════════════════════════════════ -->
                <!-- NOTEHUB TAB -->
                <!-- ═══════════════════════════════════════════════════════════════ -->
                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="📝" FontSize="14"/>
                            <TextBlock Text="NoteHub"/>
                        </StackPanel>
                    </TabItem.Header>
                    
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,20,0,0">
                        <StackPanel Spacing="20" MaxWidth="600" HorizontalAlignment="Center" Margin="0,0,0,40">
                            <!-- Feature Card -->
                            <Border Background="{StaticResource SurfaceElevatedBrush}" 
                                    CornerRadius="{StaticResource RadiusL}" 
                                    Padding="32"
                                    BoxShadow="{StaticResource ShadowBase}">
                                <StackPanel Spacing="24" HorizontalAlignment="Center">
                                    <!-- Icon -->
                                    <Border Width="80" Height="80" CornerRadius="40" HorizontalAlignment="Center">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                                <GradientStop Color="#7C3AED" Offset="0"/>
                                                <GradientStop Color="#6D28D9" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <TextBlock Text="📝" FontSize="36" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>

                                    <!-- Title and Description -->
                                    <StackPanel Spacing="8" HorizontalAlignment="Center">
                                        <TextBlock Text="NoteHub" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Your personal markdown note-taking workspace with folder navigation and organization." 
                                                   Classes="subtitle" 
                                                   TextAlignment="Center" 
                                                   MaxWidth="400" 
                                                   TextWrapping="Wrap"
                                                   LineHeight="22"/>
                                    </StackPanel>

                                    <!-- Features List -->
                                    <Border Background="{StaticResource SurfaceBrush}" 
                                            CornerRadius="{StaticResource RadiusM}" 
                                            Padding="20">
                                        <StackPanel Spacing="12">
                                            <StackPanel Orientation="Horizontal" Spacing="12">
                                                <TextBlock Text="✓" Foreground="{StaticResource AccentBrush}" FontWeight="Bold"/>
                                                <TextBlock Text="Markdown editing with live preview" FontSize="13" Opacity="0.85"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Spacing="12">
                                                <TextBlock Text="✓" Foreground="{StaticResource AccentBrush}" FontWeight="Bold"/>
                                                <TextBlock Text="Folder-based organization" FontSize="13" Opacity="0.85"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Spacing="12">
                                                <TextBlock Text="✓" Foreground="{StaticResource AccentBrush}" FontWeight="Bold"/>
                                                <TextBlock Text="Customizable storage location" FontSize="13" Opacity="0.85"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <!-- Action Button -->
                                    <Button Classes="btn-primary" 
                                            Command="{Binding OpenNoteHubCommand}"
                                            HorizontalAlignment="Center"
                                            Padding="24,12">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="Open NoteHub"/>
                                            <TextBlock Text="→"/>
                                        </StackPanel>
                                    </Button>

                                    <!-- Settings Hint -->
                                    <TextBlock Text="Configure storage location in Settings → NoteHub" 
                                               FontSize="12" 
                                               Opacity="0.5" 
                                               HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- ═══════════════════════════════════════════════════════════════ -->
                <!-- DESKTOP BUILDS TAB -->
                <!-- ═══════════════════════════════════════════════════════════════ -->
                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="💾" FontSize="14"/>
                            <TextBlock Text="Desktop Builds"/>
                        </StackPanel>
                    </TabItem.Header>
                    
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,20,0,0">
                        <StackPanel Spacing="20" Margin="0,0,0,40">
                            <!-- Header Card -->
                            <Border Classes="card-row" Background="{StaticResource SurfaceElevatedBrush}" 
                                    CornerRadius="{StaticResource RadiusM}" Padding="16">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="Desktop Configurations" FontWeight="SemiBold" FontSize="16"/>
                                        <TextBlock Text="Save and restore your box layouts and positions" Classes="subtitle" FontSize="12"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Classes="btn-primary" 
                                            Command="{Binding SaveDesktopBuildCommand}"
                                            ToolTip.Tip="Save current desktop configuration">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="💾"/>
                                            <TextBlock Text="Save Current"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Border>

                            <!-- Empty State -->
                            <Border Background="{StaticResource SurfaceElevatedBrush}" 
                                    CornerRadius="{StaticResource RadiusL}" 
                                    Padding="40"
                                    IsVisible="{Binding DesktopBuilds.Count, Converter={StaticResource IntIsZeroToBoolConverter}}">
                                <StackPanel Spacing="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Border Width="72" Height="72" CornerRadius="36" HorizontalAlignment="Center">
                                        <Border.Background>
                                            <SolidColorBrush Color="#EA580C" Opacity="0.15"/>
                                        </Border.Background>
                                        <TextBlock Text="💾" FontSize="32" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Spacing="6" HorizontalAlignment="Center">
                                        <TextBlock Text="No saved builds" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Save your current desktop configuration to quickly restore it later." 
                                                   Classes="subtitle" TextAlignment="Center" MaxWidth="320" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <Button Classes="btn-primary" 
                                            Command="{Binding SaveDesktopBuildCommand}" 
                                            HorizontalAlignment="Center"
                                            Margin="0,8,0,0">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="💾"/>
                                            <TextBlock Text="Save Current Configuration"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Border>

                            <!-- Builds List -->
                            <ItemsControl ItemsSource="{Binding DesktopBuilds}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Spacing="12"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:DesktopBuildViewModel">
                                        <Border Classes="card-row" 
                                                Background="{StaticResource SurfaceElevatedBrush}" 
                                                CornerRadius="{StaticResource RadiusL}" 
                                                Padding="20">
                                            <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                                                <!-- Build Icon -->
                                                <Border Grid.Column="0" 
                                                        Width="48" Height="48" 
                                                        CornerRadius="12" 
                                                        Margin="0,0,16,0"
                                                        VerticalAlignment="Center">
                                                    <Border.Background>
                                                        <SolidColorBrush Color="#EA580C" Opacity="0.12"/>
                                                    </Border.Background>
                                                    <TextBlock Text="💾" FontSize="22" 
                                                               HorizontalAlignment="Center" 
                                                               VerticalAlignment="Center"/>
                                                </Border>

                                                <!-- Build Info -->
                                                <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="15"/>
                                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                                            <TextBlock Text="📦" FontSize="12" Opacity="0.6"/>
                                                            <TextBlock Text="{Binding BoxCount, StringFormat='{}{0} boxes'}" 
                                                                       FontSize="13" Opacity="0.6"/>
                                                        </StackPanel>
                                                        <TextBlock Text="•" Opacity="0.4"/>
                                                        <TextBlock Text="{Binding CreatedAtDisplay}" 
                                                                   FontSize="13" Opacity="0.6"/>
                                                    </StackPanel>
                                                </StackPanel>

                                                <!-- Actions -->
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                    <Button Content="Restore" Classes="btn-primary"
                                                            Command="{Binding DataContext.RestoreDesktopBuildCommand, ElementName=DashboardView}" 
                                                            CommandParameter="{Binding}"
                                                            ToolTip.Tip="Restore this configuration"/>
                                                    <Button Classes="btn-danger"
                                                            Command="{Binding DataContext.DeleteDesktopBuildCommand, ElementName=DashboardView}" 
                                                            CommandParameter="{Binding}"
                                                            ToolTip.Tip="Delete this build"
                                                            Padding="10,8">
                                                        <TextBlock Text="🗑" FontSize="14"/>
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </Grid>
    </Border>
</UserControl>
