<UserControl x:Name="DashboardView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Boxes.App.ViewModels"
             xmlns:controls="using:Boxes.App.Views.Controls"
             x:Class="Boxes.App.Views.DashboardPageView"
             x:DataType="vm:DashboardPageViewModel"
             mc:Ignorable="d">

    <Design.DataContext>
        <vm:DashboardPageViewModel/>
    </Design.DataContext>

    <ScrollViewer Name="ScrollViewer" VerticalScrollBarVisibility="Hidden">
        <Border HorizontalAlignment="Center" MaxWidth="1000" Padding="16">
        <StackPanel Spacing="32">
            <StackPanel Spacing="4">
                <TextBlock Text="Dashboard" Classes="title"/>
                <TextBlock Text="Manage your desktop boxes" Classes="subtitle"/>
            </StackPanel>

            <StackPanel Spacing="24" Margin="0,32,0,0">
                <TextBlock Text="Boxes" FontSize="18" FontWeight="SemiBold"/>
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Button Content="New Box" Classes="btn-primary" Command="{Binding NewBoxCommand}"/>
                    <Button Content="Edit" Classes="btn-subtle" Command="{Binding EditBoxCommand}"/>
                    <Button Content="Delete" Classes="btn-danger" Command="{Binding DeleteBoxCommand}"/>
                    <Button Content="{Binding DesktopCleanupButtonText}" Classes="btn-subtle" Command="{Binding ToggleDesktopCleanupCommand}" IsEnabled="{Binding CanToggleDesktopCleanup}"/>
                </StackPanel>

                <!-- Empty state -->
                <Border x:Name="EmptyState" Classes="card-row" Background="{StaticResource SurfaceElevatedBrush}" CornerRadius="{StaticResource RadiusL}" Padding="20"
                        IsVisible="{Binding Boxes.Count, Converter={StaticResource IntIsZeroToBoolConverter}}">
                    <StackPanel Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="No boxes yet" FontSize="18" FontWeight="SemiBold"/>
                        <TextBlock Text="Create your first box to start organizing your desktop." Classes="subtitle"/>
                        <Button Content="Create a Box" Classes="btn-primary" Command="{Binding NewBoxCommand}" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <ListBox ItemsSource="{Binding Boxes}" SelectedItem="{Binding SelectedBox, Mode=TwoWay}" BorderThickness="0" Background="Transparent">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:BoxSummaryViewModel">
                            <Border Classes="card-row"
                                    Background="{StaticResource SurfaceElevatedBrush}"
                                    CornerRadius="{StaticResource RadiusL}"
                                    Margin="0,0,0,10">
                                <Grid RowDefinitions="Auto,Auto">
                                    <!-- Header -->
                                    <Border Grid.Row="0" Padding="16">
                                        <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                                            <!-- Left: name/ID -->
                                            <StackPanel Grid.Column="0" MinWidth="200">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="16"/>
                                                <TextBlock Text="{Binding Description}" Opacity="0.75" FontSize="12"/>
                                            </StackPanel>

                                            <!-- Middle: badges/metadata -->
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                <Border Classes="badge">
                                                    <TextBlock Classes="badge-text" Text="{Binding ItemCount, StringFormat='Items {0}'}"/>
                                                </Border>
                                            </StackPanel>

                                            <!-- Right: actions -->
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                <Button Content="Open" Classes="btn-primary"
                                                        Command="{Binding DataContext.OpenBoxCommand, ElementName=DashboardView}" CommandParameter="{Binding}"
                                                        ToolTip.Tip="Open box" AutomationProperties.Name="Open box"/>
                                                <Button Content="Settings" Classes="btn-subtle"
                                                        Command="{Binding DataContext.ConfigureBoxSettingsCommand, ElementName=DashboardView}" CommandParameter="{Binding}"
                                                        ToolTip.Tip="Box settings" AutomationProperties.Name="Box settings"/>
                                                <Button Content="Templates" Classes="btn-subtle"
                                                        Command="{Binding DataContext.ToggleTemplatesForBoxCommand, ElementName=DashboardView}" CommandParameter="{Binding}"
                                                        ToolTip.Tip="Show template options" AutomationProperties.Name="Box templates"/>
                                                <Button Content="Delete" Classes="btn-danger"
                                                        Command="{Binding DataContext.DeleteBoxCommand, ElementName=DashboardView}" CommandParameter="{Binding}"
                                                        ToolTip.Tip="Delete box" AutomationProperties.Name="Delete box"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <!-- Template section (animated via MaxHeight; reliable under virtualization) -->
                                    <Border Grid.Row="1"
                                            ClipToBounds="True"
                                            MaxHeight="{Binding IsTemplatesExpanded, Converter={StaticResource BoolToTemplateMaxHeight}}"
                                            Opacity="{Binding IsTemplatesExpanded, Converter={StaticResource BoolToOpacity}}"
                                            IsHitTestVisible="{Binding IsTemplatesExpanded}">
                                        <Border.Transitions>
                                            <Transitions>
                                                <DoubleTransition Property="MaxHeight" Duration="0:0:0.38"/>
                                                <DoubleTransition Property="Opacity" Duration="0:0:0.18"/>
                                            </Transitions>
                                        </Border.Transitions>

                                        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Opacity="0.55" Padding="16,14,16,16">
                                            <StackPanel Spacing="12">
                                                <StackPanel Spacing="2" HorizontalAlignment="Center">
                                                    <TextBlock Text="Templates" FontWeight="SemiBold" FontSize="14" HorizontalAlignment="Center"/>
                                                    <TextBlock Text="Pick a layout preset for this box (placeholders)" Opacity="0.7" FontSize="12" HorizontalAlignment="Center"/>
                                                </StackPanel>

                                                <ItemsControl ItemsSource="{Binding DataContext.AvailableTemplates, ElementName=DashboardView}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <WrapPanel Orientation="Horizontal"
                                                                       HorizontalAlignment="Center"
                                                                       ItemWidth="160"
                                                                       ItemHeight="160"/>
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="vm:BoxTemplateOptionViewModel">
                                                            <Border Width="160" Height="160"
                                                                    Background="{StaticResource SurfaceBrush}"
                                                                    CornerRadius="{StaticResource RadiusS}"
                                                                    BorderBrush="{StaticResource BorderBrush}"
                                                                    BorderThickness="1"
                                                                    Margin="6"
                                                                    Padding="14">
                                                                <Border.Styles>
                                                                    <Style Selector="Border:pointerover">
                                                                        <Setter Property="Background" Value="{StaticResource SurfaceElevatedBrush}"/>
                                                                        <Setter Property="BorderBrush" Value="{StaticResource AccentMutedBrush}"/>
                                                                        <Setter Property="BoxShadow" Value="{StaticResource ShadowBase}"/>
                                                                        <Setter Property="RenderTransform" Value="scale(1.02)"/>
                                                                    </Style>
                                                                </Border.Styles>
                                                                <Border.Transitions>
                                                                    <Transitions>
                                                                        <BrushTransition Property="Background" Duration="0:0:0.12"/>
                                                                        <BrushTransition Property="BorderBrush" Duration="0:0:0.12"/>
                                                                        <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.12"/>
                                                                        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.12"/>
                                                                    </Transitions>
                                                                </Border.Transitions>
                                                                <Border.RenderTransformOrigin>0.5,0.5</Border.RenderTransformOrigin>
                                                                <Grid>
                                                                    <Border Background="{StaticResource AccentMutedBrush}"
                                                                            CornerRadius="10"
                                                                            Padding="8,3"
                                                                            HorizontalAlignment="Right"
                                                                            VerticalAlignment="Top">
                                                                        <Border.IsVisible>
                                                                            <MultiBinding Converter="{StaticResource StringEqualsToBoolConverter}">
                                                                                <Binding Path="Key"/>
                                                                                <Binding Path="DataContext.SelectedBox.TemplateKey" ElementName="DashboardView"/>
                                                                            </MultiBinding>
                                                                        </Border.IsVisible>
                                                                        <TextBlock Text="Selected" FontSize="11" FontWeight="SemiBold"/>
                                                                    </Border>

                                                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="10">
                                                                        <StackPanel Spacing="6" HorizontalAlignment="Center">
                                                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13"
                                                                                       HorizontalAlignment="Center" TextAlignment="Center"/>
                                                                            <TextBlock Text="{Binding ShortDescription}" FontSize="11" Opacity="0.7"
                                                                                       TextWrapping="Wrap" TextAlignment="Center" MaxWidth="120"/>
                                                                        </StackPanel>

                                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
                                                                            <Button Content="Select" Classes="btn-primary"
                                                                                    Command="{Binding DataContext.SelectTemplateForSelectedBoxCommand, ElementName=DashboardView}"
                                                                                    CommandParameter="{Binding}"
                                                                                    ToolTip.Tip="Select this template for the box" AutomationProperties.Name="Select template"/>
                                                                            <Button Content="?" Classes="btn-subtle" Width="34"
                                                                                    Command="{Binding DataContext.ShowTemplateInfoCommand, ElementName=DashboardView}"
                                                                                    CommandParameter="{Binding}"
                                                                                    ToolTip.Tip="Learn more about this template" AutomationProperties.Name="Template info"/>
                                                                        </StackPanel>
                                                                    </StackPanel>
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>

            <StackPanel Spacing="24" Margin="0,32,0,0">
                <TextBlock Text="Notepads" FontSize="18" FontWeight="SemiBold"/>
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Button Content="New Notepad" Classes="btn-primary" Command="{Binding NewBoxCommand}"
                            ToolTip.Tip="Create a new notepad (opens Create dialog)"/>
                    <Button Content="Delete" Classes="btn-danger" Command="{Binding DeleteNotepadCommand}" CommandParameter="{Binding SelectedNotepad}"/>
                </StackPanel>

                <Border Classes="card-row" Background="{StaticResource SurfaceElevatedBrush}" CornerRadius="{StaticResource RadiusL}" Padding="20"
                        IsVisible="{Binding Notepads.Count, Converter={StaticResource IntIsZeroToBoolConverter}}">
                    <StackPanel Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="No notepads yet" FontSize="18" FontWeight="SemiBold"/>
                        <TextBlock Text="Create a notepad to take quick markdown notes on your desktop." Classes="subtitle"/>
                        <Button Content="Create a Notepad" Classes="btn-primary" Command="{Binding NewBoxCommand}" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <ListBox ItemsSource="{Binding Notepads}" SelectedItem="{Binding SelectedNotepad, Mode=TwoWay}" BorderThickness="0" Background="Transparent">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:NotepadSummaryViewModel">
                            <Border Classes="card-row"
                                    Background="{StaticResource SurfaceElevatedBrush}"
                                    CornerRadius="{StaticResource RadiusL}"
                                    Margin="0,0,0,10"
                                    Padding="16">
                                <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="16"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                        <Button Content="Open" Classes="btn-primary"
                                                Command="{Binding DataContext.OpenNotepadCommand, ElementName=DashboardView}" CommandParameter="{Binding}"
                                                ToolTip.Tip="Open notepad"/>
                                        <Button Content="Delete" Classes="btn-danger"
                                                Command="{Binding DataContext.DeleteNotepadCommand, ElementName=DashboardView}"
                                                CommandParameter="{Binding}"
                                                ToolTip.Tip="Delete notepad"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>

            <Border Classes="card-row" Background="{StaticResource SurfaceElevatedBrush}" CornerRadius="{StaticResource RadiusL}" Padding="16">
                <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Spacing="4">
                            <TextBlock Text="NoteHub" FontSize="18" FontWeight="SemiBold"/>
                            <TextBlock Text="Notes with folder navigation. Choose storage location in Settings." Classes="subtitle"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Button Content="Open NoteHub" Classes="btn-primary" Command="{Binding OpenNoteHubCommand}"
                                    ToolTip.Tip="Open NoteHub" AutomationProperties.Name="Open NoteHub"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Classes="card-row" Background="{StaticResource SurfaceElevatedBrush}" CornerRadius="{StaticResource RadiusL}" Padding="16">
                <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Scan Desktop" FontSize="18" FontWeight="SemiBold"/>
                            <TextBlock Text="Find all files on your desktop to organize them." Classes="subtitle"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Button Content="Scan Now" Classes="btn-primary" Command="{Binding ScanDesktopCommand}"
                                    ToolTip.Tip="Scan your desktop for files" AutomationProperties.Name="Scan desktop"/>
                            <Button Content="Create Shortcuts" Classes="btn-subtle" Command="{Binding CreateShortcutsCommand}"
                                    ToolTip.Tip="Create shortcuts for scanned files" AutomationProperties.Name="Create shortcuts"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="{Binding ScannedFilesCount, StringFormat='{}{0} files discovered'}" FontSize="14" Opacity="0.8" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <Border Classes="card-row" Background="{StaticResource SurfaceElevatedBrush}" CornerRadius="{StaticResource RadiusL}" Padding="16">
                <StackPanel Spacing="10">
                    <TextBlock Text="Desktop Builds" FontWeight="SemiBold" FontSize="16"/>
                    <TextBlock Text="Manage your desktop builds" Classes="subtitle" FontSize="12"/>
                    <Button Content="Save Current Desktop Configuration" Classes="btn-subtle" Command="{Binding SaveDesktopBuildCommand}" HorizontalAlignment="Stretch" Margin="0,8,0,0"/>
                    
                    <ListBox ItemsSource="{Binding DesktopBuilds}" BorderThickness="0" Background="Transparent" Margin="0,8,0,0">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:DesktopBuildViewModel">
                                <Border Classes="card-row" Background="{StaticResource SurfaceElevatedBrush}" CornerRadius="{StaticResource RadiusL}" Padding="12" Margin="0,0,0,8">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14"/>
                                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                                                <TextBlock Text="{Binding BoxCount, StringFormat='{}{0} boxes'}" FontSize="12" Opacity="0.7"/>
                                                <TextBlock Text="{Binding CreatedAtDisplay}" FontSize="12" Opacity="0.7"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="8" Grid.Column="1" VerticalAlignment="Center">
                                            <Button Content="Restore" Classes="btn-subtle" Command="{Binding DataContext.RestoreDesktopBuildCommand, ElementName=DashboardView}" CommandParameter="{Binding}"
                                                    ToolTip.Tip="Restore this build" AutomationProperties.Name="Restore desktop build"/>
                                            <Button Content="Delete" Classes="btn-danger" Command="{Binding DataContext.DeleteDesktopBuildCommand, ElementName=DashboardView}" CommandParameter="{Binding}"
                                                    ToolTip.Tip="Delete this build" AutomationProperties.Name="Delete desktop build"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </Border>
        </StackPanel>
        </Border>
    </ScrollViewer>
</UserControl>

