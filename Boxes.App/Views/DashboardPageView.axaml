<UserControl x:Name="DashboardView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Boxes.App.ViewModels"
             x:Class="Boxes.App.Views.DashboardPageView"
             x:DataType="vm:DashboardPageViewModel"
             mc:Ignorable="d">

    <Design.DataContext>
        <vm:DashboardPageViewModel/>
    </Design.DataContext>

    <ScrollViewer Name="ScrollViewer" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="32">
            <StackPanel Spacing="4">
                <TextBlock Text="Dashboard" FontSize="24" FontWeight="Bold"/>
                <TextBlock Text="Manage your desktop boxes" Opacity="0.7"/>
            </StackPanel>

            <StackPanel Spacing="24">
                <TextBlock Text="Boxes" FontSize="18" FontWeight="SemiBold"/>
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Button Content="New Box" Command="{Binding NewBoxCommand}"/>
                    <Button Content="Edit" Command="{Binding EditBoxCommand}"/>
                    <Button Content="Delete" Command="{Binding DeleteBoxCommand}" Foreground="#FF5555"/>
                    <Button Content="{Binding DesktopCleanupButtonText}" Command="{Binding ToggleDesktopCleanupCommand}" IsEnabled="{Binding CanToggleDesktopCleanup}"/>
                </StackPanel>

                <ListBox ItemsSource="{Binding Boxes}" SelectedItem="{Binding SelectedBox, Mode=TwoWay}" BorderThickness="0" Background="Transparent">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:BoxSummaryViewModel">
                            <Border Background="#141B2D" CornerRadius="12" Padding="16" Margin="0,0,0,12">
                                <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="16"/>
                                        <TextBlock Text="{Binding Description}" Opacity="0.75" FontSize="12"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="12" Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding ItemCount}" FontSize="20" FontWeight="Bold"/>
                                        <Button Content="Open" Command="{Binding DataContext.OpenBoxCommand, ElementName=DashboardView}" CommandParameter="{Binding}"/>
                                        <Button Content="Settings" Command="{Binding DataContext.ConfigureBoxSettingsCommand, ElementName=DashboardView}" CommandParameter="{Binding}"/>
                                        <Button Content="Delete" Foreground="#FF5555" Command="{Binding DataContext.DeleteBoxCommand, ElementName=DashboardView}" CommandParameter="{Binding}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>

            <Border Background="#141B2D" CornerRadius="12" Padding="16">
                <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Scan Desktop" FontSize="18" FontWeight="SemiBold"/>
                            <TextBlock Text="Find all files on your desktop to organize them." Opacity="0.7"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Button Content="Scan Now" Command="{Binding ScanDesktopCommand}"/>
                            <Button Content="Create Shortcuts" Command="{Binding CreateShortcutsCommand}"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="{Binding ScannedFilesCount, StringFormat='{}{0} files discovered'}" FontSize="14" Opacity="0.8" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <Border Background="#141B2D" CornerRadius="12" Padding="16">
                <StackPanel Spacing="10">
                    <TextBlock Text="Desktop Builds" FontWeight="SemiBold" FontSize="16"/>
                    <TextBlock Text="Manage your desktop builds" Opacity="0.7" FontSize="12"/>
                    <Button Content="Save Current Desktop Configuration" Command="{Binding SaveDesktopBuildCommand}" HorizontalAlignment="Stretch" Margin="0,8,0,0"/>
                    
                    <ListBox ItemsSource="{Binding DesktopBuilds}" BorderThickness="0" Background="Transparent" Margin="0,8,0,0">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:DesktopBuildViewModel">
                                <Border Background="#232B46" CornerRadius="8" Padding="12" Margin="0,0,0,8">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14"/>
                                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                                                <TextBlock Text="{Binding BoxCount, StringFormat='{}{0} boxes'}" FontSize="12" Opacity="0.7"/>
                                                <TextBlock Text="{Binding CreatedAtDisplay}" FontSize="12" Opacity="0.7"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="8" Grid.Column="1" VerticalAlignment="Center">
                                            <Button Content="Restore" Command="{Binding DataContext.RestoreDesktopBuildCommand, ElementName=DashboardView}" CommandParameter="{Binding}"/>
                                            <Button Content="Delete" Foreground="#FF5555" Command="{Binding DataContext.DeleteDesktopBuildCommand, ElementName=DashboardView}" CommandParameter="{Binding}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>

