<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Boxes.App.ViewModels"
        xmlns:conv="using:Boxes.App.Converters"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="720"
        x:Class="Boxes.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="Boxes • Desktop Organizer"
        MinWidth="900"
        MinHeight="600">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Window.Resources>
        <SolidColorBrush x:Key="NavBackgroundBrush" Color="#1A1D2E"/>
        <SolidColorBrush x:Key="ContentBackgroundBrush" Color="#0D0F17"/>
        <SolidColorBrush x:Key="AdvertisingBackgroundBrush" Color="#12152A"/>
        <conv:BooleanToBrushConverter x:Key="NavSelectionBrush">
            <conv:BooleanToBrushConverter.TrueBrush>
                <SolidColorBrush Color="#2A3A5A"/>
            </conv:BooleanToBrushConverter.TrueBrush>
            <conv:BooleanToBrushConverter.FalseBrush>
                <SolidColorBrush Color="Transparent"/>
            </conv:BooleanToBrushConverter.FalseBrush>
        </conv:BooleanToBrushConverter>
    </Window.Resources>

    <Window.Styles>
        <!-- Navigation item hover styles -->
        <Style Selector="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="ListBoxItem:pointerover">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="ListBoxItem:selected">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="ListBoxItem:focus">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        
        <!-- Custom nav item border styling -->
        <Style Selector="ListBoxItem Border.nav-item">
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15"/>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.15"/>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.1"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="ListBoxItem:pointerover Border.nav-item">
            <Setter Property="Background" Value="#1E2540"/>
        </Style>
        <Style Selector="ListBoxItem:selected Border.nav-item">
            <Setter Property="Background" Value="#2A3A5A"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentMutedBrush}"/>
        </Style>
    </Window.Styles>

    <Grid ColumnDefinitions="230,*,340" RowDefinitions="*" ColumnSpacing="20" Margin="20">
        <!-- Navigation Sidebar -->
        <Border Grid.Column="0"
                Background="{StaticResource NavBackgroundBrush}"
                Padding="20"
                CornerRadius="{StaticResource RadiusL}"
                BoxShadow="{StaticResource ShadowBase}"
                PointerPressed="OnDeselectPointerPressed">
            <Grid RowDefinitions="Auto,*,Auto">
                <!-- App Header -->
                <StackPanel Spacing="6" Margin="4,0,0,24">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="📦" FontSize="22"/>
                        <TextBlock Text="Boxes" FontSize="24" FontWeight="Bold"/>
                    </StackPanel>
                    <TextBlock Text="Your desktop, curated." Classes="subtitle" Margin="0,2,0,0"/>
                </StackPanel>
                
                <!-- Navigation Items -->
                <ListBox Grid.Row="1" 
                         ItemsSource="{Binding NavigationItems}"
                         SelectedItem="{Binding SelectedNavigationItem, Mode=TwoWay}"
                         Background="Transparent"
                         BorderThickness="0"
                         ScrollViewer.VerticalScrollBarVisibility="Hidden"
                         AutomationProperties.Name="Navigation menu">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="6"/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:NavigationItemViewModel">
                            <Border Classes="nav-item"
                                    Background="{Binding IsSelected, Converter={StaticResource NavSelectionBrush}}"
                                    BorderBrush="Transparent"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource RadiusM}" 
                                    Padding="14,12" 
                                    Cursor="Hand"
                                    ToolTip.Tip="{Binding Description}">
                                <Grid ColumnDefinitions="Auto,*">
                                    <TextBlock Grid.Column="0" Text="{Binding Icon}" FontSize="18" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14"/>
                                        <TextBlock Text="{Binding Description}" FontSize="11" Opacity="0.65" 
                                                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" MaxWidth="140"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                
                <!-- Footer -->
                <Border Grid.Row="2" 
                        Background="{StaticResource SurfaceElevatedBrush}" 
                        CornerRadius="{StaticResource RadiusS}"
                        Padding="12,10"
                        Margin="0,16,0,0">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="💡" FontSize="14"/>
                        <TextBlock Text="Tip: Right-click desktop for quick access" FontSize="11" Opacity="0.7" 
                                   TextWrapping="Wrap" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Main Content Area -->
        <Border Grid.Column="1"
                Background="{StaticResource ContentBackgroundBrush}"
                Padding="28"
                CornerRadius="{StaticResource RadiusL}"
                BoxShadow="{StaticResource ShadowBase}"
                PointerPressed="OnDeselectPointerPressed">
            <ContentControl Content="{Binding CurrentPage}"/>
        </Border>

        <!-- Right Sidebar -->
        <Border Grid.Column="2" 
                Background="{StaticResource AdvertisingBackgroundBrush}" 
                Padding="24" 
                CornerRadius="{StaticResource RadiusL}"
                BoxShadow="{StaticResource ShadowBase}">
            <ContentControl Content="{Binding SidebarContent}"/>
        </Border>
    </Grid>

</Window>
